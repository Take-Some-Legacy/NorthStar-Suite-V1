{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "northstar.dataset.maturity_scan.v1",
  "title": "North Star dataSet maturity scan",
  "type": "object",
  "required": ["schema", "generated_at", "index_first", "module_completeness_matrix", "questions", "capability_matrix_delta", "conformance_todo", "repair_queue", "model_hints"],
  "properties": {
    "schema": {"const": "northstar.dataset.maturity_scan.v1"},
    "generated_at": {"type": "string"},
    "index_first": {"const": true},
    "manifest": {"type": "object"},
    "maturity_scale": {"type": "object", "additionalProperties": {"type": "string"}},
    "module_completeness_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["archive", "mapped_gateways", "status", "maturity_score", "missing", "risks", "next_pass"],
        "properties": {
          "archive": {"type": "string"},
          "archive_id": {"type": "string"},
          "topics": {"type": "array", "items": {"type": "string"}},
          "file_count": {"type": "integer"},
          "mapped_gateways": {"type": "array", "items": {"type": "string", "pattern": "^engine\\."}},
          "status": {"type": "string", "enum": ["covered", "visible_gap", "missing_gateway", "external_reference", "unmapped", "directory_only"]},
          "maturity_score": {"type": "integer", "minimum": 0, "maximum": 5},
          "domain_maturity_scores": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 5}},
          "missing": {"type": "array", "items": {"type": "string"}},
          "risks": {"type": "array", "items": {"type": "string"}},
          "next_pass": {"type": "string"},
          "forbidden_direct_copy_notes": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "questions": {"type": "array", "items": {"type": "object"}},
    "capability_matrix_delta": {"type": "array", "items": {"type": "object"}},
    "conformance_todo": {"type": "array", "items": {"type": "object"}},
    "repair_queue": {
      "type": "object",
      "required": ["P0", "P1", "P2"],
      "properties": {
        "P0": {"type": "array", "items": {"type": "object"}},
        "P1": {"type": "array", "items": {"type": "object"}},
        "P2": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "token_scan": {"type": "object"},
    "model_hints": {
      "type": "object",
      "required": ["truth_source", "browser_policy", "direct_copy_policy"],
      "properties": {
        "truth_source": {"type": "string"},
        "browser_policy": {"type": "string"},
        "direct_copy_policy": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
