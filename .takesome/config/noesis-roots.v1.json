{
  "schema": "noesis.suite.roots.v1",
  "roots": {
    "suite_root": {
      "path": "${suite_input_root}"
    },
    "tool_root": {
      "path": "${suite_root}/tools"
    },
    "toolbelt_root": {
      "path": "${tool_root}"
    },
    "workspace_root": {
      "path": "C:/Users/HUAWEI/Documents/Repos"
    },
    "runtime_root": {
      "env": [
        "NOESIS_RUNTIME_ROOT",
        "NOESIS_SUITE_RUNTIME_ROOT",
        "NORTHSTAR_SUITE_RUNTIME_ROOT"
      ],
      "fallback": "${machine_runtime_root}"
    },
    "config_root": {
      "path": "${suite_root}/.takesome/config"
    },
    "intelligence_root": {
      "path": "${suite_root}/.takesome/intelligence"
    },
    "chat_root": {
      "path": "${intelligence_root}/chat"
    },
    "task_artifacts_root": {
      "path": "${intelligence_root}/task-artifacts"
    },
    "config_overrides_root": {
      "path": "${intelligence_root}/config-overrides"
    },
    "source_apply_root": {
      "path": "${intelligence_root}/source-apply"
    }
  },
  "root_metadata": {
    "suite_root": {
      "purpose": "Noesis Suite source and control repository"
    },
    "tool_root": {
      "purpose": "Suite tool descriptors and scripts"
    },
    "toolbelt_root": {
      "purpose": "Self-contained toolbelt root"
    },
    "workspace_root": {
      "purpose": "Canonical repository/artifact root operated by Suite"
    },
    "runtime_root": {
      "purpose": "Machine-local runtime/state root"
    },
    "config_root": {
      "purpose": "Versioned Noesis configuration root"
    },
    "intelligence_root": {
      "purpose": "Noesis intelligence runtime artifacts"
    },
    "chat_root": {
      "purpose": "Noesis/assistant chat channel"
    },
    "task_artifacts_root": {
      "purpose": "Generic artifacts produced for the currently assigned task."
    },
    "config_overrides_root": {
      "purpose": "Task-scoped runtime overlays for configured Noesis config data."
    },
    "source_apply_root": {
      "purpose": "Approval-gated source apply requests and state."
    }
  },
  "files": {
    "workloop_decision": "${intelligence_root}/workloop-decision.json",
    "workloop_trace_summary": "${intelligence_root}/workloop-trace.md",
    "assigned_task_md": "${intelligence_root}/assigned-task.md",
    "task_scan": "${intelligence_root}/task-scan.json",
    "chat_journal": "${chat_root}/noesis-chat.jsonl",
    "chat_state": "${chat_root}/chat-state.json",
    "chat_noesis_to_assistant": "${chat_root}/noesis-to-assistant.md",
    "chat_assistant_to_noesis": "${chat_root}/assistant-to-noesis.md",
    "chat_unread_for_assistant": "${chat_root}/unread-for-assistant.json",
    "chat_unread_for_noesis": "${chat_root}/unread-for-noesis.json",
    "operator_response": "${intelligence_root}/operator-response.md",
    "task_artifact_current_proposal": "${task_artifacts_root}/current/proposal.md",
    "task_artifact_current_draft": "${task_artifacts_root}/current/draft.md",
    "task_artifact_current_review_packet": "${task_artifacts_root}/current/review-packet.json",
    "task_artifact_current_review_request": "${task_artifacts_root}/current/review-request.md",
    "task_artifact_writer_state": "${task_artifacts_root}/writer-state.json",
    "task_artifact_writer_events": "${task_artifacts_root}/writer-events.jsonl",
    "task_artifact_proposals_dir": "${task_artifacts_root}/proposals",
    "task_artifact_drafts_dir": "${task_artifacts_root}/drafts",
    "task_artifact_review_packets_dir": "${task_artifacts_root}/review-packets",
    "task_artifact_review_requests_dir": "${task_artifacts_root}/review-requests",
    "config_override_proposals_dir": "${config_overrides_root}/proposals",
    "config_override_active_dir": "${config_overrides_root}/active",
    "config_override_archive_dir": "${config_overrides_root}/archive",
    "config_override_state": "${config_overrides_root}/state.json",
    "config_override_events": "${config_overrides_root}/events.jsonl",
    "config_override_effective_cache_dir": "${config_overrides_root}/effective",
    "source_apply_request_current": "${source_apply_root}/current/request.md",
    "source_apply_state": "${source_apply_root}/state.json",
    "source_apply_events": "${source_apply_root}/events.jsonl",
    "source_apply_requests_dir": "${source_apply_root}/requests",
    "source_apply_approval_current": "${source_apply_root}/approval/current/approval.json",
    "source_apply_approvals_dir": "${source_apply_root}/approval/approvals",
    "source_apply_executor_state": "${source_apply_root}/executor/state.json",
    "source_apply_executor_events": "${source_apply_root}/executor/events.jsonl",
    "source_apply_executions_dir": "${source_apply_root}/executor/executions",
    "source_apply_patch_staging_dir": "${source_apply_root}/executor/patches",
    "source_apply_validation_current": "${source_apply_root}/validation/current/report.json",
    "source_apply_validation_reports_dir": "${source_apply_root}/validation/reports",
    "source_apply_commit_request_current": "${source_apply_root}/commit/current/request.md",
    "source_apply_commit_requests_dir": "${source_apply_root}/commit/requests",
    "task_artifact_current_updated_version": "${task_artifacts_root}/current/updated-version.md",
    "task_artifact_updated_versions_dir": "${task_artifacts_root}/updated-versions",
    "task_artifact_current_repo_update_manifest": "${task_artifacts_root}/current/repo-update-manifest.json",
    "task_artifact_current_repo_patch": "${task_artifacts_root}/current/repo.patch",
    "task_artifact_current_repo_files_dir": "${task_artifacts_root}/current/repo-files",
    "task_artifact_repo_update_manifests_dir": "${task_artifacts_root}/repo-update-manifests",
    "task_artifact_repo_patches_dir": "${task_artifacts_root}/repo-patches",
    "task_artifact_repo_files_dir": "${task_artifacts_root}/repo-files"
  },
  "self": {
    "config_key": "noesis_roots_config",
    "base_file": "${config_root}/noesis-roots.v1.json"
  },
  "configs": {
    "noesis_roots_config": "${config_root}/noesis-roots.v1.json"
  },
  "source_apply": {
    "schema": "noesis.suite.source_apply_capability.v1",
    "enabled": false,
    "enablement_mode": "runtime_config_overlay",
    "approval_required": true,
    "direct_source_write_without_approval": false,
    "auto_apply": false,
    "auto_commit": false,
    "auto_push": false,
    "validation_required": true,
    "commit_requires_separate_request": true,
    "push_requires_separate_request": true,
    "enabled_by": "",
    "enabled_utc": "",
    "enable_reason": "",
    "last_enable_task_id": "",
    "admin_default_overridden": false
  },
  "runtime_permissions": {
    "admin_defaults": {
      "schema": "noesis.suite.runtime_admin_defaults.v1",
      "enabled": true,
      "activation_when": {
        "windows_process_is_admin": true,
        "bridge_write_enabled_env_any": [
          "NOESIS_SUITE_WRITE_ENABLED",
          "NORTHSTAR_WRITE_ENABLED",
          "SUITE_WRITE_ENABLED"
        ],
        "env_truthy_values": [
          "1",
          "true",
          "yes",
          "on"
        ]
      },
      "default_profile": "all_permissions_active",
      "capabilities": {
        "source_apply": {
          "enabled": true,
          "enablement_mode": "admin_runtime_default",
          "approval_required": false,
          "direct_source_write_without_approval": true,
          "auto_apply": true,
          "auto_commit": true,
          "auto_push": true,
          "validation_required": true,
          "commit_requires_separate_request": false,
          "push_requires_separate_request": false,
          "enabled_by": "admin_runtime_default",
          "enable_reason": "Suite process is running with administrator/write privileges; default permissions are active by config policy."
        }
      },
      "audit": {
        "runtime_fact_required": true,
        "effective_state_must_report_admin_default": true,
        "explicit_disable_sets_admin_default_overridden": true,
        "base_config_mutation_required": false
      }
    }
  }
}
