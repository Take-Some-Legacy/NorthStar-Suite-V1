{
  "schema": "takesome.tool.v2",
  "id": "vendor.symbol_extract",
  "version": "1.0.0",
  "name": "Symbol Extract",
  "description": "Third-party workspace/debug utility for extracting or listing symbols from executable/debug-symbol inputs.",
  "kind": "external-cli",
  "source_type": "third_party",
  "owner": "third-party",
  "root": ".",
  "package_root": "tools/toolbelt/third_party/symbol_extract",
  "executable": "bin/SymbolExtract.exe",
  "install_path": "tools/toolbelt/third_party/symbol_extract/bin/SymbolExtract.exe",
  "expected_sha256": "67b4a88e47a462843eed5ef1d6e3219aea2a79c100e5b33130a47810c39e5e62",
  "expected_size_bytes": 15872,
  "safe_for_build": false,
  "build_validation": false,
  "safe_to_auto_run": false,
  "maturity": "vendor-provisional",
  "capabilities": [
    "workspace.symbols.extract",
    "workspace.debug.symbols",
    "diagnostics.symbol_dump"
  ],
  "commands": [
    {
      "id": "help",
      "description": "Print tool usage. This tool prints usage when launched without arguments.",
      "args": []
    },
    {
      "id": "extract",
      "description": "Extract/list symbols from an executable or debug-symbol file.",
      "args_schema": [
        { "name": "input", "flag": "-in", "required": true, "description": "Input executable or debug-symbol file." },
        { "name": "output", "flag": "-out", "required": false, "description": "Output text file. If omitted, output goes to stdout." },
        { "name": "exclude", "flag": "-exclude", "required": false, "description": "Exclude symbols containing this substring." },
        { "name": "searchpath", "flag": "-searchpath", "required": false, "description": "Symbol search path used while loading an executable." }
      ],
      "example_args": ["-in", "example.exe", "-out", "symbols.txt"]
    }
  ],
  "validation": {
    "mode": "presence_and_hash",
    "args": []
  },
  "usage_file": "USAGE.txt",
  "readme": "README.md"
}
