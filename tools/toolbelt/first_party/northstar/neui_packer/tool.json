{
  "schema": "takesome.tool.v2",
  "id": "northstar.neui_packer",
  "version": "0.2.1",
  "name": "North Star NEUI Packer",
  "description": "XML-first .neui UI dictionary packer/inspector/validator.",
  "kind": "rust-cli",
  "source_type": "first_party",
  "owner": "Take Some",
  "root": ".",
  "package_root": "tools/toolbelt/first_party/northstar/neui_packer",
  "source_root": "tools/toolsSrc/neui_packer",
  "executable": "bin/northstar-neui-packer.cmd",
  "install_path": "tools/toolbelt/first_party/northstar/neui_packer/bin/northstar-neui-packer.exe",
  "cargo_manifest": "tools/toolsSrc/neui_packer/Cargo.toml",
  "safe_for_build": true,
  "build_validation": true,
  "commands": [
    {
      "id": "help",
      "args": [
        "--help"
      ],
      "description": "Print tool usage."
    },
    {
      "id": "version",
      "args": [
        "version"
      ],
      "description": "Print tool version."
    },
    {
      "id": "accepted-inputs",
      "args": [
        "accepted-inputs"
      ],
      "description": "Print accepted input and output file contract."
    },
    {
      "id": "doctor",
      "description": "Run descriptor-level doctor checks: executable presence, descriptor shape, lifecycle command availability, and bounded launch metadata.",
      "args": [
        "doctor"
      ],
      "safe": true,
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "implemented_by_bridge": true
    }
  ],
  "capabilities": [],
  "sha256": "c3a3bfb73d701063ec4cfc229c52d524427008d56892de27bbe9d802902fca73",
  "suite_commands": [
    {
      "id": "build-ui",
      "title": "Build NEUI dictionary",
      "description": "Compile XML-first .neui.xml sources into NEF8 .neui runtime assets.",
      "tool_args": [
        "compile",
        "--root",
        "."
      ],
      "args": [
        {
          "name": "input",
          "flags": [
            "--input",
            "-i"
          ],
          "kind": "path",
          "default": "",
          "required": false,
          "help": "Single .neui.xml source. Defaults to --all.",
          "tool_flag": "--input"
        },
        {
          "name": "output",
          "flags": [
            "--output",
            "-o"
          ],
          "kind": "path",
          "default": "",
          "required": false,
          "help": "Output .neui path for a single input.",
          "tool_flag": "--output"
        },
        {
          "name": "check",
          "flags": [
            "--check"
          ],
          "kind": "bool",
          "action": "store_true",
          "help": "Validate and print planned outputs without writing .neui files.",
          "tool_flag": "--check"
        }
      ],
      "auto_flags_if_empty": [
        {
          "name": "input",
          "flags": [
            "--all"
          ]
        }
      ],
      "riskTier": "write"
    },
    {
      "id": "inspect-ui",
      "title": "Inspect NEUI dictionary",
      "description": "Inspect a NEF8 .neui file and print a readable JSON summary.",
      "tool_args": [
        "inspect"
      ],
      "args": [
        {
          "name": "input",
          "flags": [
            "--input",
            "-i"
          ],
          "kind": "path",
          "default": "",
          "required": false,
          "help": "Input .neui file. Defaults to first discovered UI asset.",
          "tool_flag": "--input",
          "default_discover": {
            "kind": "first_existing_or_glob",
            "paths": [],
            "glob_roots": [
              "EngineRepo/NewEngine/neocore2/assets/ui",
              "NewEngine/neocore2/assets/ui"
            ],
            "glob": "*.neui"
          }
        }
      ],
      "riskTier": "read_only"
    },
    {
      "id": "validate-ui",
      "title": "Validate NEUI dictionary",
      "description": "Validate .neui.xml and .neui assets through the native NEUI packer.",
      "tool_args": [
        "validate",
        "--root",
        "."
      ],
      "args": [
        {
          "name": "input",
          "flags": [
            "--input",
            "-i"
          ],
          "kind": "path",
          "default": "",
          "required": false,
          "help": "Single .neui.xml or .neui file. Defaults to all UI assets.",
          "tool_flag": "--input"
        }
      ],
      "auto_flags_if_empty": [
        {
          "name": "input",
          "flags": [
            "--all"
          ]
        }
      ],
      "riskTier": "read_only"
    }
  ],
  "expected_sha256": "44d3591e8b33b15f2807f46b3496e69804f87840f2cf96ad53e0ddb6e72e8abf",
  "expected_size_bytes": 893,
  "availability": "launcher_present_binary_requires_build",
  "backend_executable": "northstar-neui-packer.exe"
}
