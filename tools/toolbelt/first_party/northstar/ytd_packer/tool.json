{
  "schema": "takesome.tool.v2",
  "id": "northstar.ytd_packer",
  "version": "0.3.1",
  "name": "North Star YTD Packer",
  "description": "Texture dictionary .ytd packer/inspector/validator/extractor.",
  "kind": "rust-cli",
