{
  "schema": "takesome.tool.v2",
  "id": "northstar.ddsinfo",
  "version": "1.2.0-stability.1",
  "name": "North Star DDS Info",
  "description": "First-party source-owned DDS metadata inspector for dimensions, compression, DXGI format, mipmaps and recursive scans.",
  "kind": "dotnet-host-cli",
  "source_type": "first_party",
  "owner": "North Star",
  "maturity": "first-party-stable",
  "root": "tools/toolbelt/first_party/northstar/ddsinfo",
  "package_root": "tools/toolbelt/first_party/northstar/ddsinfo",
  "source_root": "tools/toolsSrc/ddsinfo",
  "build_system": "dotnet",
  "build_command": [
    "dotnet",
    "publish",
    "ddsinfo.csproj",
    "-c",
    "Release",
    "-r",
    "win-x64",
    "--self-contained",
    "false",
    "-p:PublishSingleFile=false",
    "-p:PublishReadyToRun=false",
    "-o",
    "publish"
  ],
  "executable": "bin/ddsinfo.exe",
  "install_path": "tools/toolbelt/first_party/northstar/ddsinfo/bin/ddsinfo.exe",
  "expected_sha256": "2db7341c7eddbe719846ef9f21956f7312e051f7fe3833c0ec271c58275be28e",
  "expected_size_bytes": 154112,
  "safe_for_build": true,
  "build_validation": true,
  "safe_to_auto_run": false,
  "capabilities": [
    "assets.texture.dds.inspect",
    "assets.texture.dds.dimensions",
    "assets.texture.dds.compression",
    "workspace.image.scan"
  ],
  "commands": [
    {
      "id": "version",
      "description": "Print version information.",
      "args": [
        "--version"
      ],
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    {
      "id": "help",
      "description": "Print usage information.",
      "args": [
        "--help"
      ],
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true
    },
    {
      "id": "inspect",
      "description": "Inspect DDS files or directories.",
      "example_args": [
        "-r",
        "-c",
        "-d",
        "."
      ]
    },
    {
      "id": "dimensions",
      "description": "Display image dimensions.",
      "args": [
        "--dimensions"
      ]
    },
    {
      "id": "compression",
      "description": "Display DDS compression method.",
      "args": [
        "--compression"
      ]
    },
    {
      "id": "accepted-inputs",
      "description": "Print descriptor-provided accepted input/output contract.",
      "args": [
        "accepted-inputs"
      ],
      "safe": true,
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "implemented_by_bridge": true
    },
    {
      "id": "doctor",
      "description": "Run descriptor-level doctor checks: executable presence, descriptor shape, lifecycle command availability, and bounded launch metadata.",
      "args": [
        "doctor"
      ],
      "safe": true,
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "implemented_by_bridge": true
    }
  ],
  "validation": {
    "mode": "presence_hash_version",
    "args": [
      "--library",
      "$repo_root/tools/toolbelt/libraries/northstar.ddsinfo.dll",
      "--version"
    ],
    "expect_stdout_contains": "ddsinfo Version: 1.2.0.0"
  },
  "usage_file": "USAGE.txt",
  "readme": "README.md",
  "shared_libs": [
    {
      "id": "northstar.ddsinfo.managed",
      "path": "tools/toolbelt/libraries"
    }
  ],
  "managed_libraries": [
    {
