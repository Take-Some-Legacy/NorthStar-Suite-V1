      "riskTier": "read_only"
    },
    {
      "id": "graph-nemat",
      "title": "Project NEMAT graph",
      "description": "Emit NEMAT dependency graph JSON projection.",
      "tool_args": [
        "graph"
      ],
      "args": [
        {
          "name": "input",
          "flags": [
            "--input",
            "-i"
          ],
          "kind": "path",
          "default": "",
          "required": false,
          "help": "Input .nemat file. Defaults to discovered asset.",
          "tool_flag": "--input",
          "default_discover": {
            "kind": "first_existing_or_glob",
            "paths": [],
            "glob_roots": [
              "EngineRepo/NewEngine/neocore2/assets",
              "NewEngine/neocore2/assets"
            ],
            "glob": "*.nemat"
          }
        },
        {
          "name": "output",
          "flags": [
