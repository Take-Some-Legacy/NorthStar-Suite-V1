            "-i"
          ],
          "kind": "path",
          "default": "",
          "required": false,
          "help": "Input .nemat file. Defaults to discovered asset.",
          "tool_flag": "--input",
          "default_discover": {
            "kind": "first_existing_or_glob",
            "paths": [],
            "glob_roots": [
              "EngineRepo/NewEngine/neocore2/assets",
              "NewEngine/neocore2/assets"
            ],
            "glob": "*.nemat"
          }
        },
        {
          "name": "output",
          "flags": [
            "--output",
            "-o"
          ],
          "kind": "path",
          "default": "",
          "required": false,
          "help": "Output .nemat.xml path.",
          "tool_flag": "--output"
        }
      ],
      "riskTier": "read_only"
    },
    {
      "id": "manifest-nemat",
      "title": "Project NEMAT manifest",
      "description": "Emit NEMAT manifest JSON projection.",
      "tool_args": [
        "manifest"
      ],
      "args": [
        {
          "name": "input",
          "flags": [
            "--input",
            "-i"
          ],
          "kind": "path",
          "default": "",
          "required": false,
          "help": "Input .nemat file. Defaults to discovered asset.",
          "tool_flag": "--input",
          "default_discover": {
            "kind": "first_existing_or_glob",
            "paths": [],
            "glob_roots": [
