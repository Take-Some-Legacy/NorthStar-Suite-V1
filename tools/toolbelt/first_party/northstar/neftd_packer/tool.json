  "kind": "rust-cli",
  "source_type": "first_party",
  "owner": "Take Some",
  "root": ".",
  "package_root": "tools/toolbelt/first_party/northstar/neftd_packer",
  "source_root": "tools/toolsSrc/neftd_packer",
  "executable": "bin/northstar-neftd-packer.exe",
  "install_path": "tools/toolbelt/first_party/northstar/neftd_packer/bin/northstar-neftd-packer.exe",
